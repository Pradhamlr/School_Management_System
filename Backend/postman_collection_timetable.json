{
  "info": {
    "_postman_id": "timetable-collection-001",
    "name": "School Management - Timetable Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "timetableId", "value": "" },
    { "key": "adminEmail", "value": "admin@school.test" },
    { "key": "adminPassword", "value": "password123" }
  ],
  "item": [
    {
      "id": "auth-login",
      "name": "Auth - Login (Admin)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "5000",
          "path": [ "api", "auth", "login" ]
        },
        "event": [
          {
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json && json.token) { pm.collectionVariables.set('token', json.token); }",
                "if (json && json.user && json.user.id) { pm.collectionVariables.set('userId', json.user.id); }"
              ],
              "type": "text/javascript"
            }
          }
        ],
        "response": []
      }
    },
    {
      "id": "timetable-create",
      "name": "Timetables - Create",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"classId\": 1,\n  \"subjectId\": 1,\n  \"teacherId\": 1,\n  \"classroomId\": 1,\n  \"day\": \"MON\",\n  \"startMinute\": 540,\n  \"endMinute\": 600\n}" },
        "url": {
          "raw": "http://localhost:5000/api/timetables",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "5000",
          "path": [ "api", "timetables" ]
        },
        "event": [
          {
            "listen": "test",
            "script": {
              "exec": [
            "const json = pm.response.json();",
            "if (json && json.data && json.data.id) {",
            "  const id = json.data.id;",
            "  pm.collectionVariables.set('timetableId', id);",
            "  try { pm.environment.set('timetableId', id); } catch(e) { /* ignore if no env */ }",
            "}"
              ],
              "type": "text/javascript"
            }
          }
        ],
        "response": []
      }
    },
    {
      "id": "timetable-getall",
      "name": "Timetables - Get All",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": {
          "raw": "http://localhost:5000/api/timetables",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "5000",
          "path": [ "api", "timetables" ]
        },
        "response": []
      }
    },
    {
      "id": "timetable-getbyid",
      "name": "Timetables - Get By ID",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": {
          "raw": "http://localhost:5000/api/timetables/{{timetableId}}",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "5000",
          "path": [ "api", "timetables", "{{timetableId}}" ]
        },
        "response": []
      }
    },
    {
      "id": "timetable-update",
      "name": "Timetables - Update",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"startMinute\": 610,\n  \"endMinute\": 660\n}" },
        "event": [
          {
            "listen": "prerequest",
            "script": {
              "exec": [
                "// Ensure timetableId exists before sending request",
                "const id = pm.variables.get('timetableId') || pm.collectionVariables.get('timetableId') || pm.environment.get('timetableId');",
                "if (!id) { throw new Error('timetableId is not set. Run Timetables - Create first or set timetableId variable.'); }"
              ],
              "type": "text/javascript"
            }
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/timetables/{{timetableId}}",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "5000",
          "path": [ "api", "timetables", "{{timetableId}}" ]
        },
        "response": []
      }
    },
    {
      "id": "timetable-delete",
      "name": "Timetables - Delete",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": {
          "raw": "http://localhost:5000/api/timetables/{{timetableId}}",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "5000",
          "path": [ "api", "timetables", "{{timetableId}}" ]
        },
        "response": []
      }
    }
  ]
}
