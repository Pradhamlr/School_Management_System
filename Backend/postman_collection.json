{
  "info": {
    "name": "School Management API - Full",
    "description": "Postman collection to test main API flows. Emphasis on notifications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "adminEmail", "value": "admin@school.com" },
    { "key": "adminPassword", "value": "admin123" }
  ],
  "item": [
    {
      "name": "Auth - Signup Admin",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"role\": \"ADMIN\"\n}" },
        "url": "{{baseUrl}}/api/auth/signup"
      }
    },
    {
      "name": "Auth - Login (Admin)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Students - Create (Admin)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": 3,\n  \"rollNumber\": \"STU001\",\n  \"class\": \"10A\",\n  \"section\": \"A\",\n  \"dob\": \"2008-05-15\"\n}" },
        "url": "{{baseUrl}}/api/students"
      }
    },
    {
      "name": "Teachers - Create (Admin)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": 2,\n  \"subject\": \"Mathematics\",\n  \"department\": \"Science\",\n  \"hireDate\": \"2024-01-15\"\n}" },
        "url": "{{baseUrl}}/api/teachers"
      }
    },
    {
      "name": "Attendance - Mark Student (Teacher)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"studentId\": 3,\n  \"date\": \"2025-10-03\",\n  \"status\": \"PRESENT\",\n  \"remarks\": \"On time\"\n}" },
        "url": "{{baseUrl}}/api/attendance/students"
      }
    },
    {
      "name": "Attendance - Get Students Today",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": "{{baseUrl}}/api/attendance/students/today"
      }
    },
    {
      "name": "Notifications - Create (Admin)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Test Notification\",\n  \"message\": \"This is a notification test message.\",\n  \"targetRole\": \"STUDENT\"\n}" },
        "url": "{{baseUrl}}/api/notifications"
      }
    },
    {
      "name": "Notifications - Get All",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": "{{baseUrl}}/api/notifications"
      }
    },
    {
      "name": "Notifications - Get By ID",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": "{{baseUrl}}/api/notifications/1"
      }
    },
    {
      "name": "Notifications - Delete (Admin)",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": "{{baseUrl}}/api/notifications/1"
      }
    }
  ]
}
