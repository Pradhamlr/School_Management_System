{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "sync": "sh ./sync.sh",
    "dev:local": "cross-env NODE_ENV=local dotenv -e .env.local -- nodemon src/server.js",
    "studio:local": "dotenv -e .env.local -- npx prisma studio",
    "studio:prod": "dotenv -e .env.prod -- npx prisma studio",
    "dev:prod": "cross-env NODE_ENV=production dotenv -e .env.prod -- node src/server.js",
    "migrate:local": "dotenv -e .env.local -- npx prisma migrate dev",
    "validate:local": "dotenv -e .env.local -- npx prisma validate",
    "generate:local": "dotenv -e .env.local -- npx prisma generate",
    "migrate:prod": "dotenv -e .env.prod -- npx prisma migrate deploy",
    "deploy:local": "dotenv -e .env.local -- npx prisma migrate deploy",
    "seed:local": "dotenv -e .env.local -- npx prisma db seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@sentry/node": "^10.20.0",
    "@sentry/tracing": "^7.120.4",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^7.0.9",
    "prisma": "^6.16.2",
    "razorpay": "^2.9.6",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "nodemon": "^3.1.10"
  }
}
